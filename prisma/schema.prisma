generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// CATEGORIES
// ============================================================

model Category {
  id          String   @id @default(cuid())
  categoryId  String   @unique @map("category_id")
  name        String   @map("category_name")
  description String?
  status      String   @default("Active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  products Product[]

  @@index([status])
  @@map("categories")
}

// ============================================================
// BRANDS
// ============================================================

model Brand {
  id          String   @id @default(cuid())
  brandId     String   @unique @map("brand_id")
  name        String   @map("brand_name")
  description String?
  status      String   @default("Active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  products Product[]

  @@index([status])
  @@map("brands")
}

// ============================================================
// SUPPLIERS
// ============================================================

model Supplier {
  id            String   @id @default(cuid())
  supplierId    String   @unique @map("supplier_id")
  supplierName  String   @map("supplier_name")
  contactPerson String?  @map("contact_person")
  phone         String?
  email         String?
  address       String?
  city          String?
  accountBalance Decimal  @default(0) @map("account_balance") @db.Decimal(15, 2)
  status        String   @default("Active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  products  Product[]
  purchases Purchase[]

  @@index([status])
  @@index([phone])
  @@map("suppliers")
}

// ============================================================
// CUSTOMERS
// ============================================================

model Customer {
  id             String   @id @default(cuid())
  customerId     String   @unique @map("customer_id")
  customerName   String   @map("customer_name")
  phone          String?
  email          String?
  address        String?
  customerType   String?  @map("customer_type")
  accountBalance Decimal  @default(0) @map("account_balance") @db.Decimal(15, 2)
  status         String   @default("Active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  sales   Sale[]
  returns Return[]

  @@index([status])
  @@index([phone])
  @@map("customers")
}

// ============================================================
// PRODUCTS
// ============================================================

model Product {
  id           String   @id @default(cuid())
  productId    String   @unique @map("product_id")
  sku          String   @unique
  productName  String   @map("product_name")
  categoryId   String   @map("category_id")
  brandId      String   @map("brand_id")
  model        String?
  serialNumber String?  @map("serial_number")
  description  String?
  quantity     Int      @default(0)
  reorderLevel Int      @default(5) @map("reorder_level")
  costPrice    Decimal  @default(0) @map("cost_price") @db.Decimal(15, 2)
  sellingPrice Decimal  @default(0) @map("selling_price") @db.Decimal(15, 2)
  supplierId   String?  @map("supplier_id")
  location     String?
  status       String   @default("Active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  category       Category        @relation(fields: [categoryId], references: [categoryId])
  brand          Brand           @relation(fields: [brandId], references: [brandId])
  supplier       Supplier?       @relation(fields: [supplierId], references: [supplierId])
  saleItems      SaleItem[]
  purchaseItems  PurchaseItem[]
  returns        Return[]
  stockMovements StockMovement[]

  @@index([categoryId])
  @@index([brandId])
  @@index([supplierId])
  @@index([status])
  @@index([serialNumber])
  @@map("products")
}

// ============================================================
// USERS
// ============================================================

model User {
  id           String   @id @default(cuid())
  userId       String   @unique @map("user_id")
  fullName     String   @map("full_name")
  email        String   @unique
  phone        String?
  role         String   @default("Sales Staff")
  status       String   @default("Active")
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  sales          Sale[]
  purchases      Purchase[]
  returns        Return[]
  stockMovements StockMovement[]
  auditLogs      AuditLog[]
  permissions    UserPermission[]

  @@index([status])
  @@index([role])
  @@map("users")
}

// ============================================================
// PERMISSIONS
// ============================================================

model Permission {
  id           String   @id @default(cuid())
  permissionId String   @unique @map("permission_id")
  code         String   @unique
  name         String
  description  String?
  module       String
  createdAt    DateTime @default(now()) @map("created_at")

  users UserPermission[]

  @@index([module])
  @@map("permissions")
}

model UserPermission {
  id               String     @id @default(cuid())
  userPermissionId String     @unique @map("user_permission_id")
  userId           String     @map("user_id")
  permissionId     String     @map("permission_id")
  granted          Boolean    @default(true)
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  user       User       @relation(fields: [userId], references: [userId], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [permissionId], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@index([userId])
  @@index([permissionId])
  @@map("user_permissions")
}

// ============================================================
// SALES
// ============================================================

model Sale {
  id            String   @id @default(cuid())
  saleId        String   @unique @map("sale_id")
  invoiceNumber String   @unique @map("invoice_number")
  customerId    String?  @map("customer_id")
  saleDate      DateTime @default(now()) @map("sale_date")
  subtotal      Decimal  @default(0) @db.Decimal(15, 2)
  discount      Decimal  @default(0) @db.Decimal(15, 2)
  tax           Decimal  @default(0) @db.Decimal(15, 2)
  totalAmount   Decimal  @default(0) @map("total_amount") @db.Decimal(15, 2)
  amountPaid    Decimal  @default(0) @map("amount_paid") @db.Decimal(15, 2)
  balance       Decimal  @default(0) @db.Decimal(15, 2)
  paymentMethod String?  @map("payment_method")
  paymentStatus String   @default("Pending") @map("payment_status")
  saleStatus    String   @default("Completed") @map("sale_status")
  createdBy     String?  @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")

  customer Customer? @relation(fields: [customerId], references: [customerId])
  creator  User?     @relation(fields: [createdBy], references: [userId])

  items   SaleItem[]
  returns Return[]

  @@index([customerId])
  @@index([saleDate])
  @@index([paymentStatus])
  @@index([saleStatus])
  @@map("sales")
}

// ============================================================
// SALE ITEMS
// ============================================================

model SaleItem {
  id         String   @id @default(cuid())
  saleItemId String   @unique @map("sale_item_id")
  saleId     String   @map("sale_id")
  productId  String   @map("product_id")
  quantity   Int
  unitPrice  Decimal  @default(0) @map("unit_price") @db.Decimal(15, 2)
  discount   Decimal  @default(0) @db.Decimal(15, 2)
  total      Decimal  @default(0) @db.Decimal(15, 2)
  createdAt  DateTime @default(now()) @map("created_at")

  sale    Sale    @relation(fields: [saleId], references: [saleId], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [productId])

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

// ============================================================
// PURCHASES
// ============================================================

model Purchase {
  id             String   @id @default(cuid())
  purchaseId     String   @unique @map("purchase_id")
  purchaseNumber String   @unique @map("purchase_number")
  supplierId     String   @map("supplier_id")
  purchaseDate   DateTime @default(now()) @map("purchase_date")
  subtotal       Decimal  @default(0) @db.Decimal(15, 2)
  discount       Decimal  @default(0) @db.Decimal(15, 2)
  tax            Decimal  @default(0) @db.Decimal(15, 2)
  totalAmount    Decimal  @default(0) @map("total_amount") @db.Decimal(15, 2)
  amountPaid     Decimal  @default(0) @map("amount_paid") @db.Decimal(15, 2)
  balance        Decimal  @default(0) @db.Decimal(15, 2)
  paymentMethod  String?  @map("payment_method")
  paymentStatus  String   @default("Pending") @map("payment_status")
  purchaseStatus String   @default("Completed") @map("purchase_status")
  createdBy      String?  @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")

  supplier Supplier @relation(fields: [supplierId], references: [supplierId])
  creator  User?    @relation(fields: [createdBy], references: [userId])

  items PurchaseItem[]

  @@index([supplierId])
  @@index([purchaseDate])
  @@index([paymentStatus])
  @@index([purchaseStatus])
  @@map("purchases")
}

// ============================================================
// PURCHASE ITEMS
// ============================================================

model PurchaseItem {
  id            String   @id @default(cuid())
  purchaseItemId String   @unique @map("purchase_item_id")
  purchaseId    String   @map("purchase_id")
  productId     String   @map("product_id")
  quantity      Int
  unitCost      Decimal  @default(0) @map("unit_cost") @db.Decimal(15, 2)
  discount      Decimal  @default(0) @db.Decimal(15, 2)
  total         Decimal  @default(0) @db.Decimal(15, 2)
  createdAt     DateTime @default(now()) @map("created_at")

  purchase Purchase @relation(fields: [purchaseId], references: [purchaseId], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [productId])

  @@index([purchaseId])
  @@index([productId])
  @@map("purchase_items")
}

// ============================================================
// EXPENSES
// ============================================================

model Expense {
  id             String   @id @default(cuid())
  expenseId      String   @unique @map("expense_id")
  expenseCategory String  @map("expense_category")
  description    String?
  amount         Decimal  @default(0) @db.Decimal(15, 2)
  paymentMethod  String?  @map("payment_method")
  expenseDate    DateTime @default(now()) @map("expense_date")
  recordedBy     String?  @map("recorded_by")
  receipt        String?
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([expenseDate])
  @@index([expenseCategory])
  @@map("expenses")
}

// ============================================================
// RETURNS
// ============================================================

model Return {
  id                  String   @id @default(cuid())
  returnId            String   @unique @map("return_id")
  saleId              String   @map("sale_id")
  productId           String   @map("product_id")
  serialNumber        String?  @map("serial_number")
  customerId          String?  @map("customer_id")
  returnDate          DateTime @default(now()) @map("return_date")
  reason              String
  quantity            Int      @default(1)
  refundAmount        Decimal  @default(0) @map("refund_amount") @db.Decimal(15, 2)
  returnType          String?  @map("return_type")
  conditionAfterReturn String? @map("condition_after_return")
  status              String   @default("Pending")
  processedBy         String?  @map("processed_by")
  notes               String?
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  sale      Sale      @relation(fields: [saleId], references: [saleId])
  product   Product   @relation(fields: [productId], references: [productId])
  customer  Customer? @relation(fields: [customerId], references: [customerId])
  processor User?     @relation(fields: [processedBy], references: [userId])

  @@index([saleId])
  @@index([productId])
  @@index([customerId])
  @@index([returnDate])
  @@index([status])
  @@map("returns")
}

// ============================================================
// SETTINGS
// ============================================================

model Setting {
  id           String   @id @default(cuid())
  settingId    String   @unique @map("setting_id")
  settingName  String   @unique @map("setting_name")
  settingValue String?  @map("setting_value")
  description  String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

// ============================================================
// STOCK MOVEMENTS
// ============================================================

model StockMovement {
  id              String   @id @default(cuid())
  movementId      String   @unique @map("movement_id")
  productId       String   @map("product_id")
  movementType    String   @map("movement_type")
  quantity        Int
  previousQuantity Int     @map("previous_quantity")
  newQuantity     Int      @map("new_quantity")
  referenceId     String?  @map("reference_id")
  reason          String?
  staffId         String?  @map("staff_id")
  movementDate    DateTime @default(now()) @map("movement_date")
  notes           String?

  product Product @relation(fields: [productId], references: [productId])
  staff   User?   @relation(fields: [staffId], references: [userId])

  @@index([productId])
  @@index([movementType])
  @@index([movementDate])
  @@index([staffId])
  @@map("stock_movements")
}

// ============================================================
// AUDIT LOGS
// ============================================================

model AuditLog {
  id          String   @id @default(cuid())
  logId       String   @unique @map("log_id")
  userId      String?  @map("user_id")
  action      String
  module      String
  recordId    String?  @map("record_id")
  description String?
  ipAddress   String?  @map("ip_address")
  timestamp   DateTime @default(now())

  user User? @relation(fields: [userId], references: [userId])

  @@index([userId])
  @@index([module])
  @@index([action])
  @@index([timestamp])
  @@map("audit_logs")
}